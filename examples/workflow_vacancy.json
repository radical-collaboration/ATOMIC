{
  "name": "vacancy-classifier",
  "params": {"temperature": 300},
  "stages": [
    {"name": "md",    "type": "simulation",  "cmd": ["atomic-fake-md", "--temperature", "{temperature}", "--steps", "200", "--out", "md.json"],
     "requirements": {"cores": 2, "software": ["lammps"]}, "inputs": [], "outputs": ["md.json"]},
    {"name": "train", "type": "ml_training", "cmd": ["atomic-fake-train", "--in", "md.json", "--epochs", "20", "--duration-sec", "30", "--out", "model.json"],
     "requirements": {"cores": 1, "gpus": 1, "software": ["pytorch"]}, "inputs": ["md.json"], "outputs": ["model.json"]}
  ]
}
